{
  "expo": {
    "name": "a5-v",
    "slug": "a5-v",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icoa5.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#090714",
        "foregroundImage": "./assets/icoa5.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.a5v"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0F4F8",
          "image": "./assets/splash-icon.png",
          "dark": {
            "backgroundColor": "#090714",
            "image": "./assets/splash-icon.png"
          },
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}